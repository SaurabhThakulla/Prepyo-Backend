# Copy to .env and fill in. The API refuses to start if anything required is
# missing, so a bad deploy fails at boot instead of at the first request.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development
PORT=8080

# Comma separated. Must not contain localhost in production.
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Serving the frontend
# ---------------------------------------------------------------------------

# Path to the frontend's Vite build output (its `dist/`). Set it and this binary
# serves the app and the API from a single origin, which is how production runs:
# the session cookie is same-origin with no CORS and no proxy in between.
#
# Leave it empty for local work. `vite dev` serves the app on :3000 and proxies
# /api/v1 here, so ALLOWED_ORIGINS above is what matters instead.
#
# A path that is set but has no index.html in it stops the boot, rather than
# leaving an API that looks healthy while every page request 404s.
WEB_DIST_DIR=

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------

# Migrations run automatically at startup.
DATABASE_URL=postgres://prepyo:prepyo_pass@localhost:5432/prepyo_db?sslmode=disable

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------

# Required in production, minimum 32 characters. Generate one with:
#   openssl rand -base64 48
# Rotating it signs everyone out.
SESSION_SECRET=

# How long a session lasts. Default 14 days.
SESSION_TTL=336h

# Set true wherever the app is served over HTTPS. Defaults to true in production.
SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# AI (required in production)
# ---------------------------------------------------------------------------

# There are two providers, because no single one serves both needs. Writing and
# tutoring run on the primary provider; speaking needs a model that accepts
# audio input, which the primary provider does not have.
#
# Primary (text). Any OpenAI-compatible endpoint works: the gateway posts to
# <AI_BASE_URL>/chat/completions with a bearer token. Without a key, evaluation
# and tutor endpoints return 503 — they never fall back to a canned score.
# AI_API_KEY is required in production. CODE_CRAFT is accepted as an alias for
# it, so an environment written against the provider's own naming still works.
AI_BASE_URL=https://codecraftapi.com/v1
AI_API_KEY=

# Models on the primary provider. These are the defaults compiled into
# pkg/config; setting them here only matters when you want something else.
# GET <AI_BASE_URL>/models lists what the key can reach.
AI_MODEL_WRITING=gpt-5.6-luna
AI_MODEL_TUTORING=gpt-5.6-luna

# Audio provider, used by POST /evaluations/speaking only. That endpoint sends
# the learner's recording inline and has the model transcribe and score it in
# one call, so this must be a model that accepts audio input. A text-only model
# does not degrade gracefully here: it rejects the request and every speaking
# submission comes back as "evaluation unavailable".
#
# Leave AI_AUDIO_API_KEY empty and speaking alone is unavailable; writing and
# tutoring still work. It falls back to OPENROUTER_API_KEY, which is what this
# setting used to be called.
AI_AUDIO_BASE_URL=https://openrouter.ai/api/v1
AI_AUDIO_API_KEY=
AI_MODEL_SPEAKING=google/gemini-2.5-flash

# Deprecated alias for AI_AUDIO_API_KEY.
OPENROUTER_API_KEY=

# Transcribing and scoring a recording takes longer than marking an essay. If
# speaking evaluations start timing out, raise this before blaming the model.
# Reasoning models are slow too: a writing evaluation on gpt-5.6-luna takes
# roughly 20-25s, so leave headroom here.
AI_REQUEST_TIMEOUT=45s

# Cap on one completion. A reasoning model spends part of this budget thinking
# before it emits any JSON, so the visible answer is only a fraction of it: a
# writing evaluation on gpt-5.6-luna uses about 2,100 completion tokens, and at
# the old ceiling of 2,000 every evaluation came back truncated and was thrown
# away. Lower it only if you have measured what your model actually needs.
AI_MAX_TOKENS=8000

# ---------------------------------------------------------------------------
# Issue reporting (the "Report an issue" button in the app sidebar)
# ---------------------------------------------------------------------------
# POST /api/v1/report emails each submission through Gmail. This used to be a
# Next.js route in the frontend repo; it moved here when that app became a
# static build.
#
# GMAIL_APP_PASSWORD is a Google App Password, not the account password:
# Google Account > Security > 2-Step Verification > App passwords.
#
# Unset is a supported state — the API boots fine and the dialog tells the
# reporter that reporting is not switched on here. Set both to turn it on.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where reports land. Defaults to sauravthakulla683@gmail.com.
REPORT_EMAIL_TO=

# ---------------------------------------------------------------------------
# Not used yet
# ---------------------------------------------------------------------------

# Reserved for rate limiting and the background job queue. Rate limiting is
# currently per-instance and in-memory.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------

# The OAuth 2.0 Web application client ID from Google Cloud Console
# (APIs & Services > Credentials). POST /auth/google verifies every ID token
# against it, so the value here must be the same one the frontend renders the
# Google button with (VITE_GOOGLE_CLIENT_ID). Required in production: without
# it the endpoint returns 503 and nobody can sign in.
# Example: 123456789012-abc123def456.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Admin sign-in
# ---------------------------------------------------------------------------

# The operations account. It is the product's only password login: learners all
# sign in with Google, and this one exists because admin@prepyo.online is a
# placeholder address with no Google account behind it.
#
# ADMIN_EMAIL must match a users row whose role is 'admin' — migration
# 000017_seed_admin_user seeds exactly that row for the default address. The
# role is read from the database on every sign-in, so revoking it there closes
# this login too.
#
# ADMIN_PASSWORD is checked in constant time against the value here; nothing is
# stored in the database, so changing it is a redeploy, not a migration. Leave
# it empty and POST /auth/admin-login returns 503. Minimum 12 characters.
# Generate one with: openssl rand -base64 24
ADMIN_EMAIL=admin@prepyo.online
ADMIN_PASSWORD=
