# Copy to .env and fill in. The API refuses to start if anything required is
# missing, so a bad deploy fails at boot instead of at the first request.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development
PORT=8080

# Comma separated. Must not contain localhost in production.
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Serving the frontend
# ---------------------------------------------------------------------------

# Path to the frontend's Vite build output (its `dist/`). Set it and this binary
# serves the app and the API from a single origin, which is how production runs:
# the session cookie is same-origin with no CORS and no proxy in between.
#
# Leave it empty for local work. `vite dev` serves the app on :3000 and proxies
# /api/v1 here, so ALLOWED_ORIGINS above is what matters instead.
#
# A path that is set but has no index.html in it stops the boot, rather than
# leaving an API that looks healthy while every page request 404s.
WEB_DIST_DIR=

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------

# Migrations run automatically at startup.
DATABASE_URL=postgres://prepyo:prepyo_pass@localhost:5432/prepyo_db?sslmode=disable

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------

# Required in production, minimum 32 characters. Generate one with:
#   openssl rand -base64 48
# Rotating it signs everyone out.
SESSION_SECRET=

# How long a session lasts. Default 14 days.
SESSION_TTL=336h

# Set true wherever the app is served over HTTPS. Defaults to true in production.
SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# AI (required in production)
# ---------------------------------------------------------------------------

# Without this, evaluation and tutor endpoints return 503. They never fall back
# to a canned score.
OPENROUTER_API_KEY=

# Any model OpenRouter routes to. These are the defaults compiled into
# pkg/config; setting them here only matters when you want something else.
AI_MODEL_WRITING=deepseek/deepseek-chat
AI_MODEL_TUTORING=deepseek/deepseek-chat

# POST /evaluations/speaking sends the learner's recording inline, so this must
# be a model that accepts audio input. A text-only model does not degrade
# gracefully here: it rejects the request and every speaking submission comes
# back as "evaluation unavailable".
AI_MODEL_SPEAKING=google/gemini-2.5-flash

# Transcribing and scoring a recording takes longer than marking an essay. If
# speaking evaluations start timing out, raise this before blaming the model.
AI_REQUEST_TIMEOUT=45s

# ---------------------------------------------------------------------------
# Issue reporting (the "Report an issue" button in the app sidebar)
# ---------------------------------------------------------------------------
# POST /api/v1/report emails each submission through Gmail. This used to be a
# Next.js route in the frontend repo; it moved here when that app became a
# static build.
#
# GMAIL_APP_PASSWORD is a Google App Password, not the account password:
# Google Account > Security > 2-Step Verification > App passwords.
#
# Unset is a supported state — the API boots fine and the dialog tells the
# reporter that reporting is not switched on here. Set both to turn it on.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where reports land. Defaults to sauravthakulla683@gmail.com.
REPORT_EMAIL_TO=

# ---------------------------------------------------------------------------
# Not used yet
# ---------------------------------------------------------------------------

# Reserved for rate limiting and the background job queue. Rate limiting is
# currently per-instance and in-memory.
REDIS_URL=redis://localhost:6379
